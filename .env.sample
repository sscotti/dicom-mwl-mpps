# dicom-mwl-mpps — default local development
# Copy: cp -n .env.sample .env && make dev-setup
# Used with IsiX RIS: see IsiX_RIS/docs/dev-environment.md
#
# Host ports (Compose): DICOM 4104→104, API 8000, MySQL 3306
# IsiX Locations: AETitle MWL-MPPS-SCP, 127.0.0.1:4104, Worklist ✓

# Database Configuration
DB_HOST=mysql_db
DB_USER=root
DB_PASSWORD=root
DB_NAME=orthanc_ris
DB_PORT=3306

# DICOM Service Configuration (must match IsiX Locations AETitle)
DICOM_AE_TITLE=MWL-MPPS-SCP
DICOM_PORT=104
DICOM_BIND_ADDRESS=0.0.0.0
DICOM_MAX_ASSOC=10

# API Configuration (RIS posts to http://host.docker.internal:8000/mwl/create_from_json)
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_CORS_ORIGINS=*

# Worklist Configuration
WORKLIST_DIR=/worklist
WORKLIST_MAX_AGE_DAYS=30

# Logging
LOG_LEVEL=INFO
ENVIRONMENT=development